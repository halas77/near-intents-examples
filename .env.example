SENDER_NEAR_ACCOUNT=your-account.near
SENDER_PRIVATE_KEY=ed25519:5D9PZd2a...
ONE_CLICK_JWT=eyJhbGciOiJSUzI1N....

INTENTS_SDK_PRIVATE_KEY_NEAR=ed25519:5D9PZd2a...
INTENTS_SDK_PRIVATE_KEY_EVM=0x...



# Multi-token contract
MT_CONTRACT=v2_1.omni.hot.tg

# Your contract that implements mt_on_transfer
MT_RECEIVER_ID=roughrobe4214.near

# Token IDs to batch transfer
MT_TOKEN_IDS=["137_3hpYoaLtt8MP1Z2GH1U473DMRKgr", "137_qiStmoQJDQPTebaPjgx5VBxZv6L"]

# Amounts in base units
MT_AMOUNTS=["2000","2000"]

# The callback message passed to roughrobe4214.near's mt_on_transfer
# (set this to whatever JSON your contract parses, or an empty object "{}" if not required)
MT_CALLBACK_MSG_JSON={"action":"deposit","account_id":"roughrobe4214.near"}

# Optional: Allocate 50 to 100 TGas so mt_on_transfer and resolve have plenty of execution gas
MT_MIN_GAS=50000000000000

# Optional: Storage deposit in yoctoNEAR if roughrobe4214.near is not yet registered on v2_1.omni.hot.tg
MT_STORAGE_DEPOSIT=1250000000000000000000 # 1250000000000000000000 = 1.25 NEAR